   108	  return
   109	 match current:
   110	  "incense":
   111	   say("阿澄", "火星上窜，梁上燕子惊起。我的手……能碰到它们。")
   112	   if phase == "tutorial": phase = "explore"
   113	  "sticks":
   114	   if phase == "playing":
   115	    flags.pickup = true
