    49	   game.set_spirit(false)
    50	   game.act()
    51	   game.set_spirit(true)
    52	  var ok = game.jump_to(str(path[index]))
    53	  check(bool(ok), "legal jump " + str(path[index - 1]) + " -> " + str(path[index]))
    54	
    55	func use(target: String) -> void:
    56	 move(target)
    57	 game.set_spirit(false)
    58	 game.act()
    59	 game.set_spirit(true)
    60	
    61	func fresh() -> void:
    62	 if is_instance_valid(game):
