    26	func path_to(target: String) -> Array:
    27	 var queue: Array = [[str(game.current)]]
    28	 var seen: Dictionary = {}
    29	 while not queue.is_empty():
    30	  var path: Array = queue.pop_front()
    31	  var node: String = path.back()
    32	  if node == target:
    33	   return path
    34	  if seen.has(node):
    35	   continue
    36	  seen[node] = true
    37	  for other in game.graph[node]:
    38	   var next: Array = path.duplicate()
    39	   next.append(other)
    40	   queue.append(next)
    41	 return []
