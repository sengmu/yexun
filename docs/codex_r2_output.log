   130	   else: say("小英", "轿铃之后，宫里又有第二声铃……阿弟还在架下，先让他注意到落签。")
   131	  "candle":
   132	   if phase == "playing":
   133	    flags.moved = true
   134	    flags.fuse = true
   135	    nodes.crackers[2] = Vector2(1090,450)
   136	    graph.beam = ["palanquin","lantern","crackers"]
   137	    graph.crackers = ["lantern","beam"]
   138	    say("庙祝公", "金纸烧起来了！【扑火，顺手摘下鞭炮，挪到灯架底座石礅；燎过的引线纸可以燃放。】")
   139	   else: say("阿澄", "烛焰斜向金纸。先进入一炷香前。")
   140	  "drum":
   141	   play_sound("drum")
   142	   if phase == "playing":
   143	    flags.drums = flags.get("drums",0) + 1
   144	    if flags.drums >= 3: fail("三下潮鼓震松主绳，原命运提前到来。")
   145	    else: say("阿澄", "鼓震传到灯架。再乱敲，阿弟会来不及离开……（%d／3）" % flags.drums)
   146	   else: say("阿澄", "鼓声惊动全埕。")
   147	  "flag":
   148	   flags.flag = true
   149	   say("小英／阿勇", "什么声音？【小英望向埕西，背对埕心；旗影扫过，阿勇停手，出发锣暂缓。】")
   150	  "lantern":
   151	   flags.lantern = true
   152	   say("阿澄", "花灯亮起、缓缓旋转。绳结上有一道不自然的暗影……")
   153	  "beam":
   154	   if phase != "playing":
   155	    say("阿澄", "横木吱呀作响。乱晃只会使它更早倒下。")
   156	   elif flags.get("armed",false):
   157	    fail("横木反复晃动，失去控制，灯架提前倒下。")
   158	   elif flags.get("safe",false) and flags.get("moved",false) and (flags.get("flag",false) or flags.get("cleared",false)):
