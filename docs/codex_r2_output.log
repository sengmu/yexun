   300	func sixty() -> int:
   301	 return 61
   302	
   303	func wrap_line(value: String, count: int) -> Array[String]:
   304	 var result: Array[String] = []
   305	 for i in range(0,value.length(),count): result.append(value.substr(i,count))
   306	 return result
   307	
   308	func walk_to(target: String) -> bool:
   309	 set_spirit(true)
   310	 var paths: Array = [[current]]
   311	 var visited: Array = [current]
   312	 while not paths.is_empty():
   313	  var path: Array = paths.pop_front()
   314	  if path.back() == target:
   315	   for item in path.slice(1):
   316	    if not jump_to(item): return false
   317	   return true
   318	  for neighbor in graph[path.back()]:
   319	   if neighbor not in visited:
   320	    visited.append(neighbor)
   321	    var next = path.duplicate()
   322	    next.append(neighbor)
   323	    paths.append(next)
   324	 return false
   325	
   326	func use_at(target: String) -> void:
   327	 walk_to(target)
   328	 set_spirit(false)
   329	 act()
   330	
   331	func capture_scene(kind: String, path: String) -> void:
   332	 if DisplayServer.get_name() == "headless":
   333	  push_error("CAPTURE FAIL: headless display has no rendered framebuffer; use Xvfb or a real display.")
   334	  get_tree().quit(2)
   335	  return
   336	 start_game()
   337	 use_at("incense")
   338	 start_incense()
   339	 if kind == "ending":
   340	  for id in ["sticks","palanquin","candle","flag","beam","crackers"]: use_at(id)
   341	 else:
   342	  use_at("horse")
   343	  set_spirit(kind == "spirit")
   344	 await get_tree().process_frame
   345	 await get_tree().process_frame
   346	 await RenderingServer.frame_post_draw
   347	 var err = get_viewport().get_texture().get_image().save_png(path)
   348	 print("CAPTURE ",kind," ",path," error=",err)
   349	 get_tree().quit(err)

