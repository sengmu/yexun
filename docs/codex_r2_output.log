 root.add_child(g)
 g.start_game()
 g.set_spirit(false)
 g.act()
 g.start_incense()
func sequence(items):
 for id in items: g.use_at(id)
func run():
 fresh()
 sequence([\"candle\",\"flag\",\"beam\"])
 print(\"R2 missing safe: armed=\",g.flags.get(\"armed\",false),\" phase=\",g.phase)
 fresh()
 sequence([\"sticks\",\"palanquin\",\"flag\",\"beam\"])
 print(\"R2 missing moved: armed=\",g.flags.get(\"armed\",false),\" phase=\",g.phase)
