   181	 queue_redraw()
   182	
   183	func advance_time(delta: float) -> void:
   184	 if phase != "playing" or spirit: return
   185	 remaining -= delta * time_scale
   186	 if pickup_left > 0 and not flags.get("safe",false):
   187	  pickup_left -= delta * time_scale
   188	  if pickup_left <= 0:
   189	   flags.pickup = false
   190	   say("阿弟", "签捡到了……我回去绑绳。")
   191	 if remaining <= 0: fail("一炷香燃尽，第三下出发锣响，灯架倒下。未完成改命。")
   192	 queue_redraw()
   193	
   194	func fail(reason: String) -> void:
   195	 phase = "failure"
   196	 failure_wait = 5.0
   197	 if flags.get("safe",false):
   198	  say("阿澄", reason + " 阿弟已经扶轿离开落点，但未能完成安全放倒的闭环。回到香点，仍需烛台、停锣或清场，再晃横木燃放。")
   199	 else:
   200	  say("阿弟的亡魂", reason + " 哥，签筒能叫我离架，神轿能留住我。烛台会让爷爷挪鞭炮。再来一次吧……")
   201	
   202	func retry() -> void:
   203	 var was_safe: bool = flags.get("safe",false)
   204	 start_game()
   205	 phase = "explore"
   206	 start_incense()
   207	 spirit = true
   208	 say("阿澄" if was_safe else "阿弟的亡魂", "香刚点燃。先看签筒，再听轿铃；架脚的鞭炮，要等烛台引来爷爷。")
   209	
   210	func finish() -> void:
   211	 phase = "ending"
   212	 current = "lantern"
   213	 flags.ending = true
   214	 say("阿弟／阿澄", "若我还在下头……【灯架倒向空埕，无人受伤，夜巡推迟。附回花灯残骸，灯光照出绳结整齐的割痕。远处第二声轿铃又响了一次。】")
   215	 play_sound("bell")
   216	
   217	func play_sound(kind: String) -> void:
   218	 audio.stream = load("res://audio/" + kind + ".wav")
   219	 audio.play()
   220	
   221	func _process(delta: float) -> void:
   222	 advance_time(delta)
   223	 if phase == "failure":
   224	  failure_wait -= delta
   225	  if failure_wait <= 0: retry()
   226	
   227	func _unhandled_input(event: InputEvent) -> void:
   228	 if event is InputEventKey and event.pressed and not event.echo:
   229	  match event.keycode:
   230	   KEY_ENTER:
   231	    if phase == "title" or phase == "ending": start_game()
   232	    elif phase == "failure": retry()
   233	   KEY_TAB: set_spirit(not spirit)
   234	   KEY_E: act()
   235	   KEY_F: start_incense()
   236	   KEY_R:
   237	    if phase == "failure": retry()
   238	   KEY_1: time_scale = 1.0
   239	   KEY_4: time_scale = 4.0
   240	 if event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_LEFT:
   241	  var p = get_global_mouse_position()
   242	  if phase == "title": start_game(); return
   243	  for id in nodes:
   244	   if p.distance_to(nodes[id][2]) < 52:
