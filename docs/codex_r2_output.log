   165	    if flags.shakes >= 2 or remaining <= 0: fail("过早摇晃，灯架提前倒下。")
   166	  "crackers":
   167	   if not flags.get("fuse",false): say("阿澄", "引线纸还未燎过，无法燃放。烛台的火能引来庙祝公。")
   168	   else:
   169	    play_sound("crackers")
