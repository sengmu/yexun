  1963	func _unhandled_input(event: InputEvent) -> void:
  1964	 if event is InputEventKey and event.pressed and not event.echo:
  1965	  if paused and event.keycode != KEY_ESCAPE: return
  1966	  match event.keycode:
  1967	   KEY_ENTER:
  1968	    if phase == "opening": advance_opening()
  1969	    elif phase == "epilogue":
  1970	     phase = "title"
  1971	     queue_redraw()
  1972	    elif phase == "title": start_opening()
  1973	    elif phase == "ending":
  1974	     if chapter != 1: pause_to_title()
  1975	     else: start_game()
  1976	    elif phase == "failure": retry()
  1977	   KEY_SPACE:
  1978	    if phase == "opening": advance_opening()
  1979	   KEY_ESCAPE:
  1980	    if paused: set_paused(false)
  1981	    elif phase == "opening": start_game()
  1982	    elif phase in ["tutorial", "explore", "playing", "failure"]: set_paused(true)
  1983	   KEY_C:
  1984	    if phase == "title" and has_save: continue_game()
  1985	   KEY_2:
  1986	    if phase == "title":
  1987	     if has_save2: continue_game2()
  1988	     else: start_chapter2()
