  4192	func tick_ch5(delta: float) -> void:
  4193	 var step = delta * time_scale
  4194	 if yield5_left > 0.0:
  4195	  yield5_left -= step
  4196	  if yield5_left <= 0.0:
  4197	   var from = yield5_from
  4198	   yield5_from = ""
  4199	   if from == "beat":
  4200	    opp5_advance_from("paperfig")
  4201	   elif from != "":
  4202	    if clean5.has(from) and not ((from == "candle" and flags.get("update1", false)) or (from == "paperfig" and flags.get("update2", false))):
  4203	     clean5.erase(from)
  4204	     trade5_used = maxi(0, trade5_used - 1)
  4205	     if from == "candle": flags.trade1_done = false
  4206	    opp5_advance_from(from)
  4207	 elif wait5:
  4208	  wait5_left -= step
  4209	  if wait5_left <= 0.0:
  4210	   wait5 = false
  4211	   opp5_timer = 45.0
  4212	 elif opp5_pos != "":
  4213	  opp5_timer -= step
  4214	  if opp5_timer <= 0.0:
  4215	   opp5_advance()
  4216	 if seg5 == 2 and not flags.get("update2", false) and phase == "playing":
  4217	  if adi5_pause > 0.0:
  4218	   adi5_pause -= step
  4219	  else:
  4220	   adi5_left -= step
  4221	   if adi5_left <= 0.0:
  4222	    adi5_left = 0.0
  4223	    fail5("阿弟攥着签走出了宫门——去库房的路，夜里黑。他和水生的话，今夜要说岔了。", "adi_left")
